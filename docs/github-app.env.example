# GitHub Rock trusted-backend GitHub App configuration
# Copy these names into your backend secret manager or deployment platform.
# Never copy this file into the Android app and never commit real values.

# GitHub App identity
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=

# Secrets: backend only
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=

# GitHub App installation scope
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_ALLOWED_OWNER=Sayanthrock-Developer
GITHUB_APP_ALLOWED_REPOSITORIES=GitHub-Rock

# Public backend routes configured in the GitHub App
GITHUB_APP_MANIFEST_REDIRECT_URL=https://your-backend.example/github/app/manifest/callback
GITHUB_APP_WEBHOOK_URL=https://your-backend.example/github/webhooks

# API and token policy
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_APP_INSTALLATION_TOKEN_TTL_SECONDS=600

# Optional hardening
GITHUB_WEBHOOK_DELIVERY_TTL_SECONDS=600
GITHUB_APP_ENFORCE_REPOSITORY_ALLOWLIST=true
GITHUB_APP_LOG_PAYLOADS=false
